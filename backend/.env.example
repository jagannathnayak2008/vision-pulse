# ==============================================================================
# OPTIGUARD AI BACKEND — RENDER & SUPABASE PRODUCTION CONFIGURATION
# ==============================================================================

PORT=5000
NODE_ENV=production

# Render Web Service URL (Auto-set by Render or specify your domain)
RENDER_EXTERNAL_URL=https://optiguard-ai-backend.onrender.com

# Client Origin (Vercel Frontend URL e.g. https://optiguard-ai.vercel.app or http://localhost:5173)
CLIENT_URL=https://optiguard-ai.vercel.app

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Dashboard > Project Settings > API & Database)
# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connection URI (Use Transaction pooler port 6543 or session port 5432)
DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 2. Supabase Project REST / Service URL
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_URL=https://your-project-id.supabase.co

# 3. Supabase Public Anon Key (for client operations / public queries)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 4. Supabase Service Role Key (Admin key for server-side RLS bypass & Storage management)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# SECURITY & MULTIMODAL AI
# ------------------------------------------------------------------------------
JWT_SECRET=optiguard_ai_super_secret_jwt_key_2026_production_grade_security_token_hex_9981
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

